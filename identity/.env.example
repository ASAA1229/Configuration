# Copy to identity/.env (gitignored) and fill in KC_BOOTSTRAP_ADMIN_PASSWORD yourself.
# Never commit identity/.env. Use at least 16 characters with upper, lower, digits and symbols.
# The username is fixed to "admin" in docker-compose.yml.
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD

# Local demo login (create-demo-user.ps1). Set the values only in identity/.env (git-ignored), never here.
# The password must meet the realm policy: 12+ characters with upper, lower, digit and symbol.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
