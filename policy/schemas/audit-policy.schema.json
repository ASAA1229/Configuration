{
  "$id": "asaa.configuration.audit-policy.v1",
  "type": "object",
  "required": ["schema", "identity", "retention", "applications"],
  "properties": {
    "schema": { "const": "asaa.configuration.audit-policy.v1" },
    "identity": { "type": "object", "required": ["actorField"], "properties": { "actorField": { "const": "sub" } } },
    "retention": { "type": "object" },
    "applications": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "application",
      "items": {
        "type": "object",
        "required": ["application", "store", "mustAudit"],
        "properties": {
          "application": { "type": "string", "minLength": 1 },
          "mustAudit": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "forwardToEcosystem": { "type": "boolean" }
        }
      }
    }
  }
}
