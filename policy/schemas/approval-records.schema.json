{
  "$id": "asaa.configuration.install-import-approvals.v1",
  "type": "object",
  "required": ["schema", "records"],
  "properties": {
    "schema": { "const": "asaa.configuration.install-import-approvals.v1" },
    "description": { "type": "string" },
    "records": {
      "type": "array",
      "x-uniqueBy": "id",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "date", "what", "why", "approver"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "what": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inventoryId": { "type": "string", "pattern": "^dep-[0-9a-f]{12}$" },
              "repo": { "type": "string" },
              "ecosystem": { "enum": ["npm", "python", "docker"] },
              "manifest": { "type": "string" },
              "section": { "type": "string" },
              "name": { "type": "string", "minLength": 1 },
              "spec": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
