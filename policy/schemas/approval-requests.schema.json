{
  "$id": "asaa.configuration.approval-requests.v1",
  "type": "object",
  "required": ["schema", "requests"],
  "properties": {
    "schema": { "const": "asaa.configuration.approval-requests.v1" },
    "requests": {
      "type": "array",
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "status", "createdAt", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-\\d{8}-[0-9A-F]{8}$" },
          "kind": { "enum": ["dependency", "discrepancy"] },
          "status": { "enum": ["pending-owner", "approved", "rejected", "withdrawn", "resolved"] },
          "items": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
